---
import T from './T.astro'

interface Props {
  seeds: string[]
}

const { seeds } = Astro.props
---

<section id="bulk" class="wrap">
  <h2><T k="bulk.title" /></h2>

  <div class="controls">
    <label for="count"><T k="bulk.count" /></label>
    <input id="count" type="number" min="1" max="200" value="16" data-count />
    <button type="button" class="primary bracketed" data-action="generate">
      <T k="bulk.generate" />
    </button>
    <button type="button" class="bracketed" data-action="copy-all">
      <T k="bulk.copyAll" />
    </button>
  </div>

  <ol class="ids" data-list data-typed>
    {seeds.map((seed) => <li>{seed}</li>)}
  </ol>
</section>
