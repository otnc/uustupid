---
import { Code } from 'astro:components'
import T from './T.astro'

const themes = { light: 'vitesse-light', dark: 'vitesse-dark' } as const

const managers = [
  { name: 'npm', command: 'npm install uustupid' },
  { name: 'pnpm', command: 'pnpm add uustupid' },
  { name: 'yarn', command: 'yarn add uustupid' },
  { name: 'bun', command: 'bun add uustupid' },
]

const usage = `import { uustupid, isUustupid } from 'uustupid'

uustupid() // => '35c8928b-2e6f-0eb0-446b-b2dd0fec9d0c'
uustupid() // => '2d3dd9e3-3048-9058-5637-710af513cf2e'

isUustupid(uustupid())          // => true
isUustupid(crypto.randomUUID()) // => false`
---

<section id="install" class="wrap">
  <h2><T k="install.title" /></h2>
  <p class="lead"><T k="install.note" /></p>

  <div class="tabs" role="group" aria-label="Package manager">
    {
      managers.map((pm, index) => (
        <button type="button" data-pm={pm.name} aria-pressed={index === 0 ? 'true' : 'false'}>
          {pm.name}
        </button>
      ))
    }
  </div>

  {
    managers.map((pm, index) => (
      <div data-command={pm.name} hidden={index !== 0}>
        <Code code={pm.command} lang="bash" themes={themes} defaultColor={false} />
      </div>
    ))
  }

  <h3><T k="install.usage" /></h3>
  <Code code={usage} lang="ts" themes={themes} defaultColor={false} />
</section>
