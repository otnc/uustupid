---
import { uustupid } from 'uustupid'
import { judge, type Reason, SAMPLE_SIZE, type Verdict } from '../ecosystem'
import type { Key } from '../i18n'
import { isRfc9562Uuid } from '../scripts/rfc9562'
import T from './T.astro'

interface Props {
  seed: string
  uuid: string
}

const { seed, uuid } = Astro.props

const rows = [
  { source: 'uustupid()', value: seed, key: 'fake' },
  { source: 'crypto.randomUUID()', value: uuid, key: 'real' },
]

// Every validator gets the same samples. One wrong answer is enough to mark a column as failed.
const ours = Array.from({ length: SAMPLE_SIZE }, () => uustupid())
const real = Array.from({ length: SAMPLE_SIZE }, () => crypto.randomUUID())
const verdicts = await judge(ours, real)

// Grouped by what each library actually answered, so a library that changes its behavior moves
// between the tables on the next build instead of failing it.
const groups: Array<{ title: Key; lead: Key; items: Verdict[] }> = [
  {
    title: 'verify.strict',
    lead: 'verify.strictLead',
    items: verdicts.filter((verdict) => verdict.oursWrong === 0),
  },
  {
    title: 'verify.loose',
    lead: 'verify.looseLead',
    items: verdicts.filter((verdict) => verdict.oursWrong > 0),
  },
]

const reasons: Record<Reason, Key> = {
  jsonSchema: 'verify.reason.jsonSchema',
  guid: 'verify.reason.guid',
  loose: 'verify.reason.loose',
  bytes: 'verify.reason.bytes',
  legacy: 'verify.reason.legacy',
}

const columns: Array<Key | string> = [
  'verify.col.package',
  'verify.col.validator',
  'uustupid()',
  'crypto.randomUUID()',
  'verify.col.intended',
]
const isKey = (column: string): column is Key => column.startsWith('verify.')

// `@scope/`, `name` and `@version` each stay whole; a long name may only break between them.
const nameParts = ({ pkg, version }: Verdict): string[] => {
  const slash = pkg.indexOf('/')
  const scoped = slash === -1 ? [pkg] : [pkg.slice(0, slash + 1), pkg.slice(slash + 1)]
  return [...scoped, `@${version}`]
}
---

<section id="verify" class="wrap">
  <h2><T k="verify.title" /></h2>
  <p class="lead"><T k="verify.lead" /></p>

  <div class="rows">
    {
      rows.map((row) => (
        <div class="row">
          <code class="row__label">{row.source}</code>
          <span class="row__value id" data-verify-value={row.key} data-typed>
            {row.value}
          </span>
          <span
            class={isRfc9562Uuid(row.value) ? 'verdict verdict--pass' : 'verdict verdict--fail'}
            data-verify-result={row.key}
          >
            <T k={isRfc9562Uuid(row.value) ? 'verify.valid' : 'verify.invalid'} />
          </span>
        </div>
      ))
    }
  </div>

  <p class="note"><T k="verify.note" /></p>

  <h3><T k="verify.libraries" /></h3>
  <p class="lead"><T k="verify.librariesLead" /></p>

  {
    groups.map((group) => (
      <>
        <h4>
          <T k={group.title} />
        </h4>
        <p class="lead">
          <T k={group.lead} />
        </p>
        <table class="checks">
          <thead>
            <tr>
              {columns.map((column) => (
                <th scope="col">{isKey(column) ? <T k={column} /> : column}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {group.items.map((verdict) => (
              <tr>
                <td>
                  <span class="checks__label" aria-hidden="true">
                    <T k="verify.col.package" />
                  </span>
                  <code class="checks__pkg">
                    {nameParts(verdict).map((part, index) => (
                      <>
                        {index > 0 && <wbr />}
                        <span>{part}</span>
                      </>
                    ))}
                  </code>
                </td>
                <td>
                  <span class="checks__label" aria-hidden="true">
                    <T k="verify.col.validator" />
                  </span>
                  <code>{verdict.fn}</code>
                </td>
                <td>
                  <span class="checks__label" aria-hidden="true">
                    uustupid()
                  </span>
                  {verdict.oursWrong === 0 ? (
                    <span class="verdict verdict--pass">
                      <T k="verify.rejectedAll" />
                    </span>
                  ) : (
                    <span class="verdict verdict--fail">
                      <T k="verify.accepted" /> {verdict.oursWrong}/{verdict.total}
                    </span>
                  )}
                </td>
                <td>
                  <span class="checks__label" aria-hidden="true">
                    crypto.randomUUID()
                  </span>
                  {verdict.realWrong === 0 ? (
                    <span class="verdict verdict--pass">
                      <T k="verify.acceptedAll" />
                    </span>
                  ) : (
                    <span class="verdict verdict--fail">
                      <T k="verify.rejected" /> {verdict.realWrong}/{verdict.total}
                    </span>
                  )}
                </td>
                <td class="checks__intended">
                  <span class="checks__label" aria-hidden="true">
                    <T k="verify.col.intended" />
                  </span>
                  {verdict.oursWrong === 0 ? (
                    <span>—</span>
                  ) : (
                    <span>
                      <strong>
                        <T
                          k={
                            verdict.reason && verdict.reason !== 'legacy'
                              ? 'verify.intended.yes'
                              : 'verify.intended.no'
                          }
                        />
                      </strong>{' '}
                      <T k={verdict.reason ? reasons[verdict.reason] : 'verify.reason.shapeOnly'} />
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ))
  }

  <p class="note"><T k="verify.librariesNote" /></p>
</section>
