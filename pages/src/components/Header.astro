---
import { NPM_URL, REPO_URL } from '../consts'
import { en } from '../i18n'
---

<header class="head wrap">
  <a class="head__name" href="/">uustupid</a>
  <a href={REPO_URL}>github</a>
  <a href={NPM_URL}>npm</a>
  <div class="lang" role="group" aria-label={en['hero.langLabel']}>
    <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
    <button type="button" data-set-lang="ja" aria-pressed="false">JA</button>
  </div>
</header>
